<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Traži je modul koji koristi glasovni unos; deklariše se ovde da
         aplikacija ne bi morala da zna koji sve moduli glas koriste. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Jezički model se preuzima na zahtev korisnika. U APK-u ga nema jer bi
         dodao 67 MB i onima koji glasovni unos ne koriste. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Vibracija po zoni u režimu bez ekrana: jedina povratna informacija koja
         stiže pre govora. -->
    <uses-permission android:name="android.permission.VIBRATE" />

</manifest>
